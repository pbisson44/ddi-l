    <r:Version>1</r:Version>
    <r:TypeOfObject>WeightingMethodology</r:TypeOfObject>
  </d:WeightingMethodologyReference>
  <r:AnalysisUnit>Household</r:AnalysisUnit>
  <d:UsageGuide>
    <d:UsageExample>
      <r:Content xml:lang="en">Apply the household weight for population totals</r:Content>
    </d:UsageExample>
    <d:UsageRestrictions>
      <r:Content xml:lang="en">Not valid for sub-regional breakdowns</r:Content>
    </d:UsageRestrictions>
    <d:UsageRecommendations>
      <r:Content xml:lang="en">Pair with replicate weights for variance estimation</r:Content>
    </d:UsageRecommendations>
    <r:CommandCode>
      <r:Description>
        <r:Content xml:lang="en">Create normalised weights</r:Content>
      </r:Description>
      <r:Command>
        <r:ProgramLanguage>R</r:ProgramLanguage>
        <r:CommandContent>weights$household &lt;- hh_weight / mean(hh_weight)</r:CommandContent>
      </r:Command>
    </r:CommandCode>
  </d:UsageGuide>
