  <r:Version>1</r:Version>
  <d:TypeOfWeighting>Calibration</d:TypeOfWeighting>
  <r:Description>
    <r:Content xml:lang="en">Weights calibrated to household counts by region and household size.</r:Content>
  </r:Description>
  <d:WeightingMethodologyReference>
    <r:URN>urn:ddi:ca.statcan:0094bff3-4091-5fa4-8fa4-033c1890905b:1</r:URN>
    <r:Agency>ca.statcan</r:Agency>
